		summarizeBy: none
		sourceColumn: TitleOfCourtesy

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Employee's date of birth. Stored as Text, not Date - convert with DATEVALUE before date arithmetic.
	column 'Birth Date'
		dataType: string
		lineageTag: 89767579-82fc-4ffd-a261-ef7b1a2f4f15
