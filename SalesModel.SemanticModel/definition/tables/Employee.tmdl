/// Represents the company's sales staff who process customer orders. Tracks historical changes to employee information (role changes, transfers) over time.
table Employee
	lineageTag: f65328fe-7a3b-4593-ba6d-c784f98ab7a0
	sourceLineageTag: [dbo].[gold_dim_employee]

	/// Average net revenue generated per sales employee.
	measure 'Revenue per Employee' =
			
			VAR TotalEmployeeswithSales = DISTINCTCOUNT('Order Sales'[Employee Reference])
			RETURN DIVIDE([Net Revenue], TotalEmployeeswithSales, 0)
		displayFolder: Sales Team
		lineageTag: 04b9413c-879d-4207-bcf3-c31aee9700ab

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Internal technical identifier linking this employee to sales.
	column 'Employee ID (Internal)'
		dataType: int64
		formatString: 0
		lineageTag: fede89be-e647-4431-8568-abb33aef49e2
		sourceLineageTag: EmployeeKey
		summarizeBy: none
		sourceColumn: EmployeeKey

		changedProperty = Description

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	/// The employee's business code.
	column 'Employee Code'
		dataType: int64
		formatString: 0
		lineageTag: 7ea5b463-827b-4bb6-a46d-a71601ce66aa
		sourceLineageTag: EmployeeId
		summarizeBy: none
		sourceColumn: EmployeeId

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// The employee's job title (e.g. Sales Representative).
	column Title
		dataType: string
		lineageTag: 46d0bd86-e1a8-4d5d-a56e-628e88aae49b
		sourceLineageTag: Title
		summarizeBy: none
		sourceColumn: Title

		changedProperty = Description

