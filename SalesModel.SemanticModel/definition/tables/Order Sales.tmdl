/// Fact, order-line grain
table 'Order Sales'
	lineageTag: 790c446d-b823-4698-bab1-4ec44d1db2c2
	sourceLineageTag: [dbo].[gold_fact_order_sales]

	/// Total sale value before any discounts are applied. Represents list-price revenue.
	measure 'Gross Revenue' =
			
			SUMX('Order Sales', 'Order Sales'[Quantity] * 'Order Sales'[Unit Price at Sale])
		displayFolder: Revenue
		lineageTag: 3ab81c59-f4eb-4aac-9764-8a623f6f9cf9

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Actual revenue earned after discounts. Primary measure for all revenue reporting.
	measure 'Net Revenue' =
			
			SUMX(
			    'Order Sales',
			    'Order Sales'[Quantity] * 'Order Sales'[Unit Price at Sale] * (1 - 'Order Sales'[Discount])
			)
		displayFolder: Revenue
		lineageTag: 0a380be2-8898-4a57-831e-017ef5ae27a8

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Percentage of gross revenue lost to discounts. High values may signal over-discounting.
	measure 'Discount % of Revenue' = ```
			
			VAR TotalDiscountAmount = 
			SUMX(
			    'Order Sales',
			    'Order Sales'[Quantity] * 'Order Sales'[Unit Price at Sale] * 'Order Sales'[Discount]
			)
			RETURN DIVIDE(TotalDiscountAmount, [Gross Revenue], 0)
			```
		displayFolder: Revenue
		lineageTag: 75541534-be67-4bd9-9219-a6c6a42e636f

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of distinct customer orders.
	measure 'Total Orders' = DISTINCTCOUNT('Order Sales'[Order Number])
		formatString: 0
		displayFolder: Orders
		lineageTag: 1c630a9b-e445-4634-a3d5-7edc9e031a99

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

	/// Total number of product units sold.
	measure 'Total Quantity Sold' = SUM('Order Sales'[Quantity])
		formatString: 0
		displayFolder: Orders
		lineageTag: 0d7148ae-bff8-4d72-ab0b-ae64d0eed27a

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

	/// Average revenue generated per order. Key indicator of customer purchasing power.
	measure 'Avg Order Value' = DIVIDE([Net Revenue], [Total Orders], 0)
		displayFolder: Orders
		lineageTag: ba5fa75d-759b-4017-8291-70ed4462eda4

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average number of distinct product lines per order.
	measure 'Avg Items per Order' = ```
			
			VAR TotalOrderLines =
			    COUNTROWS('Order Sales')
			
			RETURN
			    DIVIDE(TotalOrderLines, [Total Orders], 0)
			 
			 
			```
		displayFolder: Orders
		lineageTag: 1515213d-6b6f-484e-ac81-ab1df6af174a

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Percentage of orders delivered on time. Key carrier and logistics performance KPI.
	measure 'On-Time Delivery %' =
			
			VAR ValidLines =
			    FILTER(
			        'Order Sales',
			        NOT ISBLANK('Order Sales'[Actual Ship Date])
			            && NOT ISBLANK('Order Sales'[Required Delivery Date])
			    )
			VAR TotalLines =
			    COUNTROWS(ValidLines)
			VAR OnTimeLines =
			    COUNTROWS(
			        FILTER(
			            ValidLines,
			            'Order Sales'[Actual Ship Date]
			                <= 'Order Sales'[Required Delivery Date]
			        )
			    )
			RETURN
			    DIVIDE(OnTimeLines, TotalLines, 0)
		displayFolder: Shipping & Delivery
		lineageTag: 8452c562-d96a-4b43-b6fc-bd953822768f

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Revenue tied to orders that were shipped late — highlights financial impact of delivery delays.
	measure 'Revenue by Shipper (Late Orders)' =
			
			CALCULATE(
			    [Net Revenue],
			    FILTER(
			        'Order Sales',
			        NOT ISBLANK('Order Sales'[Actual Ship Date])
			            && NOT ISBLANK('Order Sales'[Required Delivery Date])
			            && 'Order Sales'[Actual Ship Date]
			                > 'Order Sales'[Required Delivery Date]
			    )
			)
		displayFolder: Shipping & Delivery
		lineageTag: 3319c9dd-592b-409f-8f13-d9bfb8497082

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Order count analyzed by when delivery was expected, rather than when it was placed.
	measure 'Orders by Required Date' =
			
			CALCULATE(
			    [Total Orders],
			    USERELATIONSHIP('Order Sales'[Required Delivery Date], 'Date'[Date ID])
			)
		formatString: 0
		displayFolder: Shipping & Delivery
		lineageTag: 407fed66-0d96-43be-be30-c13a206f610d

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

	/// Order count analyzed by when items actually left the warehouse.
	measure 'Orders by Shipped Date' =
			
			CALCULATE(
			    [Total Orders],
			    USERELATIONSHIP('Order Sales'[Actual Ship Date], 'Date'[Date ID])
			)
		formatString: 0
		displayFolder: Shipping & Delivery
		lineageTag: 59f66aea-8db4-47eb-baea-bc6d0061c6df

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

