	/// Late' if shipped after the required delivery date, 'On Time' if shipped on or before it, blank if not shipped yet.
	column 'Is Late Shipment' =
			
			IF(
			    ISBLANK('Order Sales'[Actual Ship Date]),
			    BLANK(),
			    IF(
			        'Order Sales'[Actual Ship Date] > 'Order Sales'[Required Delivery Date],
			        "Late",
			        "On Time"
			    )
			)
		displayFolder: Shipping & Delivery
		lineageTag: 4a4f39c8-1a12-4dc3-887e-161f82dedd87
		summarizeBy: none
		expressionContext: userContext

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	partition 'Order Sales' = entity
