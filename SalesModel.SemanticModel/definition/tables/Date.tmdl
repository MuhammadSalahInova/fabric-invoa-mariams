/// Standard calendar reference table. Does not represent a business event — exists to enable consistent date-based grouping and trend analysis (by month, quarter, year, weekday) across all fact data. Always filter/relate via this table for calendar logic.
table Date
	lineageTag: 1ba18ada-16e7-4810-b57a-9079c4b83ad1
	sourceLineageTag: [dbo].[gold_dim_date]
	dataCategory: Time

	/// Year-over-year percentage change in net revenue. Key growth KPI.
	measure 'Net Revenue YoY %' =
			
			VAR NetRevenueLY = CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('Date'[Full Date]))
			 RETURN DIVIDE([Net Revenue] - NetRevenueLY, NetRevenueLY, 0)
		displayFolder: Time Intelligence
		lineageTag: fba41c72-5b2d-459a-bd28-6a829449be89

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Numeric date identifier in YYYYMMDD format. Used to relate to fact tables.
	column 'Date ID'
		dataType: int64
		formatString: 0
		lineageTag: 8d0cde9b-1100-47dc-bfaf-3ae0d132fc9d
		sourceLineageTag: DateKey
		summarizeBy: none
		sourceColumn: DateKey

		changedProperty = Description

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'Full Date'
		dataType: dateTime
		isKey
		formatString: General Date
		lineageTag: e437c6e6-6bf0-4e28-b6ae-65967a3c5079
