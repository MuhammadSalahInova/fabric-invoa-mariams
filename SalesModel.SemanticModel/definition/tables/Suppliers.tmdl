/// Represents the companies that supply/manufacture our products. Tracks historical changes to supplier information over time. Use for supplier relationship and sourcing analysis.
table Suppliers
	lineageTag: 543f6d38-a2d3-475e-8a8f-f7b4de22e327
	sourceLineageTag: [dbo].[gold_dim_supplier]

	/// Count of distinct products sourced from this supplier.
	measure 'Products per Supplier' =
			
			CALCULATE(
			    DISTINCTCOUNT(Products[Product Code]),
			    ALLEXCEPT(Suppliers, Suppliers[Company Name])
			)
		formatString: 0
		displayFolder: Suppliers
		lineageTag: 0723675f-a2b5-4aa6-9b5d-eceea25617fa

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

	/// Average revenue generated per product for this supplier — measures supplier efficiency, not just volume.
	measure 'Avg Revenue per Supplier Product' = ```
			
			 VAR SupplierRevenue = CALCULATE([Net Revenue], ALLEXCEPT(Suppliers, Suppliers[Company Name]))
			RETURN DIVIDE(SupplierRevenue, [Products per Supplier], 0)
			```
		displayFolder: Suppliers
		lineageTag: fb91b607-0a91-47b7-b086-f3bb3695cfe9

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total count of unique suppliers in the supplier master.
	measure 'Total Suppliers' = DISTINCTCOUNT(Suppliers[Supplier Code])
		formatString: 0
		displayFolder: Suppliers
		lineageTag: f6c1833d-cc3a-4fe9-b389-1d750c73d798

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = Description

	measure SupplierRevenue = CALCULATE([Net Revenue], ALLEXCEPT(Suppliers, Suppliers[Company Name]))
		displayFolder: Suppliers
		lineageTag: 34170b37-7c8f-4ec7-a238-77396e605ddf

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Internal technical identifier linking this supplier record to products.
	column 'Supplier ID (Internal)'
		dataType: int64
		formatString: 0
		lineageTag: 8427fac9-511d-43b6-b1b5-e7a4af71f878
		sourceLineageTag: SupplierKey
		summarizeBy: none
		sourceColumn: SupplierKey

		changedProperty = Name

		changedProperty = Description

